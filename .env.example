# MySQL Database Configuration
# For local development (MAMP/XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=compass_db

# Connection Pool Settings (optional)
DB_CONNECTION_LIMIT=10

# AI API Configuration (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional: override Claude model (default: claude-sonnet-4-20250514)
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Chat Server Configuration
CHAT_SERVER_PORT=3000

# ============================================
# Docker Deployment Configuration
# ============================================
# Copy this file to .env and configure for Docker

# MySQL Root Password (for Docker MySQL container)
MYSQL_ROOT_PASSWORD=root

# MySQL User Configuration
MYSQL_USER=apm_user
MYSQL_PASSWORD=apm_password

# MySQL Port (host machine)
MYSQL_PORT=3307

# Application Port (host machine)
APP_PORT=3000

# Anthropic API Configuration for Docker
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# CLAUDE_MODEL=claude-sonnet-4-20250514
